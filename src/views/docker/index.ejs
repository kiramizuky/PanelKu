<div class="lp-page-header" style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:20px;">
  <div>
    <h1 class="lp-page-title" style="font-size:24px;font-weight:600;margin:0;">Docker Management</h1>
    <p class="lp-page-subtitle" style="color:var(--text-muted);margin:0;">Manage containers, images, and stacks</p>
  </div>
  <div style="display:flex;gap:10px">
    <button class="btn-lp btn-lp-ghost" onclick="DockerPage.loadData()"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
  </div>
</div>

<!-- Stats -->
<div class="row g-3 mb-4">
  <div class="col-6 col-md-3">
    <div class="lp-glass-card p-3 text-center">
      <div style="font-size:12px;color:var(--text-muted);text-transform:uppercase;margin-bottom:4px">Total Containers</div>
      <div style="font-size:28px;font-weight:700" id="statTotal">—</div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="lp-glass-card p-3 text-center">
      <div style="font-size:12px;color:var(--text-muted);text-transform:uppercase;margin-bottom:4px">Running</div>
      <div style="font-size:28px;font-weight:700;color:var(--accent-success)" id="statRunning">—</div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="lp-glass-card p-3 text-center">
      <div style="font-size:12px;color:var(--text-muted);text-transform:uppercase;margin-bottom:4px">Stopped</div>
      <div style="font-size:28px;font-weight:700;color:var(--accent-danger)" id="statStopped">—</div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="lp-glass-card p-3 text-center">
      <div style="font-size:12px;color:var(--text-muted);text-transform:uppercase;margin-bottom:4px">Images</div>
      <div style="font-size:28px;font-weight:700;color:var(--accent-info)" id="statImages">—</div>
    </div>
  </div>
</div>

<style>
  .dk-tabs { border-bottom: 1px solid var(--glass-border); }
  .dk-tabs .nav-link { color: var(--text-muted); background: transparent; border: none; padding: 10px 16px; font-weight: 500; border-radius: 8px 8px 0 0; }
  .dk-tabs .nav-link:hover { color: var(--text-primary); border-color: transparent; }
  .dk-tabs .nav-link.active { 
    color: var(--accent-primary); 
    background: rgba(99,102,241,0.1); 
    border: 1px solid var(--glass-border); 
    border-bottom-color: transparent; 
  }
  .dynamic-row { display: flex; gap: 10px; margin-bottom: 10px; }
</style>

<ul class="nav nav-tabs mb-4 dk-tabs">
  <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#containers"><i class="bi bi-hdd-stack me-1"></i> Containers</a></li>
  <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#app-store" onclick="DockerPage.loadAppStore()"><i class="bi bi-shop me-1 text-primary"></i> App Store (1-Click)</a></li>
  <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#images"><i class="bi bi-disc me-1"></i> Images</a></li>
  <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#create-container"><i class="bi bi-plus-circle me-1"></i> Custom Container</a></li>
  <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#docker-compose" onclick="DockerPage.loadComposeStacks()"><i class="bi bi-layers-half me-1 text-primary"></i> Compose Studio</a></li>
</ul>

<!-- Tab Content -->
<div class="tab-content">
  <!-- Containers Tab -->
  <div class="tab-pane fade show active" id="containers">
    <div class="lp-glass-card" style="padding:0;overflow-x:auto;">
      <table class="lp-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>State</th>
            <th>Image</th>
            <th>Ports</th>
            <th>Created</th>
            <th style="text-align:right">Actions</th>
          </tr>
        </thead>
        <tbody id="containersTableBody">
          <tr><td colspan="6" style="text-align:center;padding:20px;color:var(--text-muted)">Loading...</td></tr>
        </tbody>
      </table>
      <div id="containersPagination" style="padding: 0 15px 15px 15px;"></div>
    </div>
  </div>

  <!-- 1-Click App Store Tab -->
  <div class="tab-pane fade" id="app-store">
    <!-- Category Filter Bar -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
      <div class="d-flex gap-2 flex-wrap" id="appStoreCategories">
        <button class="btn-lp btn-lp-primary btn-lp-sm" onclick="DockerPage.filterAppStore('all', this)">All Apps</button>
        <button class="btn-lp btn-lp-ghost btn-lp-sm" onclick="DockerPage.filterAppStore('Web & CMS', this)">Web &amp; CMS</button>
        <button class="btn-lp btn-lp-ghost btn-lp-sm" onclick="DockerPage.filterAppStore('AI & LLM', this)">AI &amp; LLM</button>
        <button class="btn-lp btn-lp-ghost btn-lp-sm" onclick="DockerPage.filterAppStore('Dev & Tools', this)">Dev &amp; Tools</button>
        <button class="btn-lp btn-lp-ghost btn-lp-sm" onclick="DockerPage.filterAppStore('Database', this)">Database</button>
        <button class="btn-lp btn-lp-ghost btn-lp-sm" onclick="DockerPage.filterAppStore('Media & Home', this)">Media &amp; Home</button>
      </div>
      <div style="width: 240px;">
        <input type="text" id="appStoreSearch" class="lp-input" placeholder="Search apps..." oninput="DockerPage.searchAppStore(this.value)" style="height:32px; font-size:12px;">
      </div>
    </div>

    <!-- App Store Grid -->
    <div class="row g-3" id="appStoreGrid">
      <div class="col-12 text-center p-4"><p class="text-muted">Loading App Store Catalog...</p></div>
    </div>
  </div>

  <!-- Images Tab -->
  <div class="tab-pane fade" id="images">
    <div class="lp-glass-card" style="padding:0;overflow-x:auto;">
      <div style="padding:15px; border-bottom:1px solid var(--glass-border); display:flex; justify-content:space-between; align-items:center;">
        <span style="font-weight:600; color:var(--text-primary);">Docker Images</span>
        <button class="btn-lp btn-lp-danger btn-lp-sm" onclick="DockerPage.pruneImages()"><i class="bi bi-trash"></i> Prune Unused Images</button>
      </div>
      <table class="lp-table">
        <thead>
          <tr>
            <th>Repository:Tag</th>
            <th>Image ID</th>
            <th>In Use By</th>
            <th>Size</th>
            <th>Created</th>
            <th style="text-align:right">Actions</th>
          </tr>
        </thead>
        <tbody id="imagesTableBody">
          <tr><td colspan="6" style="text-align:center;padding:20px;color:var(--text-muted)">Loading...</td></tr>
        </tbody>
      </table>
      <div id="imagesPagination" style="padding: 0 15px 15px 15px;"></div>
    </div>
  </div>

  <!-- Create Custom Container Tab -->
  <div class="tab-pane fade" id="create-container">
    <div class="row g-4">
      <div class="col-12 col-lg-8">
        <div class="lp-glass-card p-4">
          <h4 style="margin-bottom:20px; font-size:16px; font-weight:600">Create Container</h4>
          <form onsubmit="DockerPage.submitContainer(event)">
            <div class="row g-3">
              <div class="col-md-6">
                <div class="lp-form-group">
                  <label class="lp-label">Container Name</label>
                  <input type="text" id="cName" class="lp-input" placeholder="my-app" required>
                </div>
              </div>
              <div class="col-md-6">
                <div class="lp-form-group">
                  <label class="lp-label">Image Name</label>
                  <input type="text" id="cImage" class="lp-input" placeholder="e.g. nginx:alpine" required>
                </div>
              </div>
            </div>

            <div class="lp-form-group mt-3">
              <label class="lp-label" style="display:flex; justify-content:space-between">
                <span>Port Mappings</span>
                <button type="button" class="btn-lp btn-lp-ghost btn-lp-sm" style="padding:2px 8px" onclick="DockerPage.addPortRow()">+ Add</button>
              </label>
              <div id="portsContainer"></div>
            </div>

            <div class="lp-form-group mt-3">
              <label class="lp-label" style="display:flex; justify-content:space-between">
                <span>Volume Mappings</span>
                <button type="button" class="btn-lp btn-lp-ghost btn-lp-sm" style="padding:2px 8px" onclick="DockerPage.addVolumeRow()">+ Add</button>
              </label>
              <div id="volumesContainer"></div>
            </div>

            <div class="lp-form-group mt-3">
              <label class="lp-label" style="display:flex; justify-content:space-between">
                <span>Environment Variables</span>
                <button type="button" class="btn-lp btn-lp-ghost btn-lp-sm" style="padding:2px 8px" onclick="DockerPage.addEnvRow()">+ Add</button>
              </label>
              <div id="envContainer"></div>
            </div>

            <div class="lp-form-group mt-3">
              <label class="lp-label">Restart Policy</label>
              <select class="lp-input" id="cRestart">
                <option value="unless-stopped">Unless Stopped</option>
                <option value="always">Always</option>
                <option value="no">No</option>
              </select>
            </div>

            <div class="form-check mt-3">
              <input class="form-check-input" type="checkbox" id="cStart" checked>
              <label class="form-check-label text-white" for="cStart">Start container immediately after creation</label>
            </div>

            <button type="submit" class="btn-lp btn-lp-primary mt-4 w-100">Create &amp; Deploy Container</button>
          </form>
        </div>
      </div>

      <div class="col-12 col-lg-4">
        <div class="lp-glass-card p-4">
          <h4 style="margin-bottom:20px; font-size:16px; font-weight:600">Search Docker Hub</h4>
          <div class="input-group">
            <input type="text" id="dockerSearchTerm" class="lp-input" placeholder="e.g. redis, node...">
            <button class="btn-lp btn-lp-primary" onclick="DockerPage.searchOnline()">Search</button>
          </div>
          <div id="onlineSearchResults" class="mt-3" style="max-height: 400px; overflow-y: auto;">
            <p class="text-muted text-center" style="font-size:12px">Search results will appear here</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Docker Compose Visual Studio & Stacks Tab -->
  <div class="tab-pane fade" id="docker-compose">
    <!-- View 1: Stacks Manager Overview -->
    <div id="composeListView">
      <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
          <h4 style="font-size:16px; font-weight:700; margin:0;" class="font-mono">
            <i class="bi bi-layers-half text-primary me-2"></i>Docker Compose Stacks
          </h4>
          <p class="text-muted small mb-0">Manage multi-container stacks, visual compositions, and automatic HTTPS reverse proxy mappings.</p>
        </div>
        <div class="d-flex gap-2">
          <button class="btn-lp btn-lp-ghost btn-lp-sm" onclick="DockerPage.loadComposeStacks()"><i class="bi bi-arrow-clockwise me-1"></i> Refresh</button>
          <div class="dropdown">
            <button class="btn-lp btn-lp-ghost btn-lp-sm dropdown-toggle" data-bs-toggle="dropdown"><i class="bi bi-box-seam me-1"></i> Quick Template</button>
            <ul class="dropdown-menu dropdown-menu-dark" style="background:#0f172a; border:1px solid var(--glass-border); font-size:12px;">
              <li><a class="dropdown-item" href="javascript:void(0)" onclick="DockerPage.newStudioFromTemplate('wordpress')"><i class="bi bi-wordpress me-2 text-info"></i>WordPress + MariaDB</a></li>
              <li><a class="dropdown-item" href="javascript:void(0)" onclick="DockerPage.newStudioFromTemplate('nextcloud')"><i class="bi bi-cloud-check me-2 text-primary"></i>Nextcloud Hub</a></li>
              <li><a class="dropdown-item" href="javascript:void(0)" onclick="DockerPage.newStudioFromTemplate('n8n')"><i class="bi bi-diagram-3 me-2 text-danger"></i>N8N Workflow Automation</a></li>
              <li><a class="dropdown-item" href="javascript:void(0)" onclick="DockerPage.newStudioFromTemplate('vaultwarden')"><i class="bi bi-shield-lock me-2 text-success"></i>Vaultwarden Password Mgr</a></li>
              <li><a class="dropdown-item" href="javascript:void(0)" onclick="DockerPage.newStudioFromTemplate('ghost')"><i class="bi bi-file-text me-2 text-warning"></i>Ghost Publishing Platform</a></li>
            </ul>
          </div>
          <button class="btn-lp btn-lp-primary btn-lp-sm" onclick="DockerPage.openNewStudio()"><i class="bi bi-plus-lg me-1"></i> New Stack (Visual Studio)</button>
        </div>
      </div>

      <!-- Stacks Grid -->
      <div id="composeStacksContainer" class="row g-3">
        <div class="col-12 text-center py-5">
          <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
          <p class="text-muted small mt-2">Loading Compose stacks...</p>
        </div>
      </div>
    </div>

    <!-- View 2: Visual Studio & YAML Editor (Hidden by default) -->
    <div id="composeStudioView" style="display:none;">
      <div class="lp-glass-card p-4">
        <!-- Studio Header -->
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2 pb-3" style="border-bottom:1px solid var(--glass-border);">
          <div class="d-flex align-items-center gap-3">
            <button class="btn-lp btn-lp-ghost btn-lp-sm" onclick="DockerPage.closeStudio()"><i class="bi bi-arrow-left me-1"></i> Back to Stacks</button>
            <h4 id="studioTitle" style="font-size:16px; font-weight:700; margin:0;" class="font-mono">
              <i class="bi bi-sliders2 text-primary me-2"></i>Visual Compose Studio
            </h4>
          </div>
          <div class="d-flex align-items-center gap-2">
            <!-- Visual / YAML Mode Switcher -->
            <div class="btn-group" role="group">
              <button type="button" id="btnModeVisual" class="btn-lp btn-lp-primary btn-lp-sm" onclick="DockerPage.setStudioMode('visual')"><i class="bi bi-ui-checks-grid me-1"></i> Visual Mode</button>
              <button type="button" id="btnModeYaml" class="btn-lp btn-lp-ghost btn-lp-sm" onclick="DockerPage.setStudioMode('yaml')"><i class="bi bi-code-square me-1"></i> Raw YAML</button>
            </div>
          </div>
        </div>

        <!-- Project Meta & Presets Bar -->
        <div class="row g-3 mb-4">
          <div class="col-md-6">
            <label class="lp-label" style="font-size:11px; font-weight:600;">Stack / Project Name</label>
            <input type="text" id="studioProjectName" class="lp-input font-mono" placeholder="e.g. web-stack, api-service" required>
            <small class="text-muted" style="font-size:10px;">Only letters, numbers, dashes, and underscores allowed.</small>
          </div>
          <div class="col-md-6">
            <label class="lp-label" style="font-size:11px; font-weight:600;">Load Stack Preset Template</label>
            <select id="studioTemplateSelect" class="lp-input" onchange="DockerPage.onStudioTemplateChange(this.value)">
              <option value="">-- Custom Blank Composition --</option>
              <option value="wordpress">WordPress + MariaDB</option>
              <option value="nextcloud">Nextcloud Hub</option>
              <option value="n8n">N8N Workflow Automation</option>
              <option value="vaultwarden">Vaultwarden (Bitwarden Server)</option>
              <option value="ghost">Ghost Blog Publishing</option>
            </select>
          </div>
        </div>

        <!-- Mode 1: Visual Services Builder -->
        <div id="studioVisualSection">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 style="font-size:13px; font-weight:700; color:var(--text-primary); margin:0;" class="font-mono">
              <i class="bi bi-boxes me-1 text-info"></i> Composed Services (<span id="serviceCount">1</span>)
            </h5>
            <button type="button" class="btn-lp btn-lp-ghost btn-lp-sm text-primary" onclick="DockerPage.addVisualService()"><i class="bi bi-plus-circle me-1"></i> Add Service</button>
          </div>

          <!-- Dynamic Service Cards Container -->
          <div id="visualServicesContainer" style="display:flex; flex-direction:column; gap:16px;"></div>

          <button type="button" class="btn-lp btn-lp-ghost w-100 py-2 mt-3" style="border: 1px dashed var(--glass-border); border-radius:10px;" onclick="DockerPage.addVisualService()">
            <i class="bi bi-plus-lg me-1"></i> Add Another Service to this Stack
          </button>
        </div>

        <!-- Mode 2: Raw YAML Code Editor (Hidden by default) -->
        <div id="studioYamlSection" style="display:none;">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <label class="lp-label" style="font-size:11px; font-weight:600;">docker-compose.yml</label>
            <small class="text-muted">Changes here automatically sync to Visual Mode when toggled.</small>
          </div>
          <textarea id="studioYaml" class="lp-input font-mono" rows="18" placeholder="version: '3.8'&#10;services:&#10;  web:&#10;    image: nginx:alpine&#10;    ports:&#10;      - '8080:80'" style="resize: vertical; line-height: 1.5; font-size:12px;" required></textarea>
        </div>

        <!-- Footer Actions -->
        <div class="d-flex justify-content-between align-items-center mt-4 pt-3" style="border-top:1px solid var(--glass-border);">
          <button type="button" class="btn-lp btn-lp-ghost" onclick="DockerPage.closeStudio()">Cancel</button>
          <button type="button" id="btnDeployStudioStack" class="btn-lp btn-lp-primary" onclick="DockerPage.submitStudioDeploy()"><i class="bi bi-rocket-takeoff me-1"></i> Deploy Stack Now</button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Auto HTTPS Reverse Proxy Modal -->
<div class="modal fade" id="composeProxyModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="background:#0f172a; border:1px solid var(--glass-border); color:#fff; border-radius:16px;">
      <div class="modal-header border-0 pb-0">
        <div>
          <h5 class="modal-title font-mono" style="font-size:15px; font-weight:700; margin:0;"><i class="bi bi-shield-check text-success me-2"></i>Connect Domain (Auto HTTPS)</h5>
          <small class="text-muted">Direct reverse proxy mapping from public domain to Docker port.</small>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <form onsubmit="DockerPage.submitAutoProxy(event)">
        <div class="modal-body pt-3">
          <div class="p-3 mb-3 rounded" style="background:rgba(16,185,129,0.08); border:1px solid rgba(16,185,129,0.2);">
            <div style="font-size:11px; color:#10b981; font-weight:600;"><i class="bi bi-info-circle-fill me-1"></i> Zero-Config HTTPS</div>
            <div style="font-size:11px; color:var(--text-muted); margin-top:2px;">Panelku will automatically create a reverse proxy vhost and issue an SSL certificate for your domain.</div>
          </div>

          <div class="lp-form-group mb-3">
            <label class="lp-label" style="font-size:11px; font-weight:600;">Stack / Project</label>
            <input type="text" id="proxyProjectName" class="lp-input font-mono" readonly style="background:rgba(0,0,0,0.3); color:var(--text-muted);">
          </div>

          <div class="row g-2 mb-3">
            <div class="col-6">
              <label class="lp-label" style="font-size:11px; font-weight:600;">Service Name</label>
              <input type="text" id="proxyServiceName" class="lp-input font-mono" readonly style="background:rgba(0,0,0,0.3); color:var(--text-muted);">
            </div>
            <div class="col-6">
              <label class="lp-label" style="font-size:11px; font-weight:600;">Container Host Port</label>
              <input type="number" id="proxyTargetPort" class="lp-input font-mono" readonly style="background:rgba(0,0,0,0.3); color:var(--text-muted);">
            </div>
          </div>

          <div class="lp-form-group mb-2">
            <label class="lp-label" style="font-size:11px; font-weight:600;">Public Domain / Subdomain</label>
            <input type="text" id="proxyDomain" class="lp-input font-mono" placeholder="e.g. app.yourdomain.com, n8n.homeserver.me" required>
            <small class="text-muted" style="font-size:10px;">Ensure DNS A/AAAA record points to this server IP.</small>
          </div>
        </div>
        <div class="modal-footer border-0 pt-0">
          <button type="button" class="btn-lp btn-lp-ghost" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" id="btnSubmitAutoProxy" class="btn-lp btn-lp-primary"><i class="bi bi-shield-lock me-1"></i> Provision HTTPS Proxy</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Stack Live Logs Modal -->
<div class="modal fade" id="composeStackLogsModal" tabindex="-1">
  <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content" style="background:#0f172a; border:1px solid var(--glass-border); color:#fff; border-radius:16px;">
      <div class="modal-header border-0 pb-0">
        <div class="d-flex align-items-center gap-2">
          <h5 class="modal-title font-mono" style="font-size:14px;"><i class="bi bi-terminal text-info me-2"></i><span id="stackLogsTitle">Stack Logs</span></h5>
        </div>
        <div class="d-flex align-items-center gap-2">
          <button class="btn-lp btn-lp-ghost btn-lp-sm" onclick="DockerPage.refreshStackLogs()"><i class="bi bi-arrow-clockwise me-1"></i> Refresh</button>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
      </div>
      <div class="modal-body pt-3">
        <div id="stackLogsTerminal" style="background:#050811; color:#38bdf8; font-family:'JetBrains Mono', monospace; font-size:12px; padding:16px; border-radius:10px; min-height:400px; max-height:550px; overflow-y:auto; white-space:pre-wrap; word-break:break-all;">Loading logs...</div>
      </div>
    </div>
  </div>
</div>

<!-- App Store 1-Click Install Modal -->
<div class="modal fade" id="appInstallModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="background:#0f172a; border:1px solid var(--glass-border); color:#fff; border-radius:16px;">
      <div class="modal-header border-0 pb-0">
        <div style="display:flex; align-items:center; gap:10px;">
          <div id="appModalIcon" style="width:36px; height:36px; border-radius:10px; display:flex; align-items:center; justify-content:center; font-size:18px;"></div>
          <div>
            <h5 class="modal-title font-mono" id="appModalTitle" style="font-size:15px; font-weight:700; margin:0;">Install App</h5>
            <small class="text-muted" id="appModalCategory">Category</small>
          </div>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <form id="appInstallForm" onsubmit="DockerPage.submitAppInstall(event)">
        <div class="modal-body pt-3">
          <p class="text-muted" id="appModalDesc" style="font-size:12px; line-height:1.4; margin-bottom:16px;"></p>
          <div class="lp-form-group mb-3">
            <label class="lp-label" style="font-size:11px; font-weight:600;">Stack / Project Name</label>
            <input type="text" id="appProjectName" class="lp-input font-mono" required>
          </div>
          <div id="appDynamicFields" style="display:flex; flex-direction:column; gap:12px;"></div>
        </div>
        <div class="modal-footer border-0 pt-0">
          <button type="button" class="btn-lp btn-lp-ghost" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" id="btnDeployApp" class="btn-lp btn-lp-primary"><i class="bi bi-rocket-takeoff me-1"></i> Deploy App Now</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Container Live Stats & Resource Limits Modal -->
<div class="modal fade" id="resourceModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="background:#0f172a; border:1px solid var(--glass-border); color:#fff; border-radius:16px;">
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title font-mono" id="resModalTitle" style="font-size:14px;"><i class="bi bi-sliders text-primary me-2"></i>Container Resource Limits</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body pt-3">
        <!-- Live Stats Gauge -->
        <div class="row g-2 mb-3">
          <div class="col-6">
            <div class="p-2 rounded text-center" style="background:rgba(0,0,0,0.3); border:1px solid var(--glass-border);">
              <small class="text-muted d-block" style="font-size:10px;">CPU USAGE</small>
              <h4 id="resLiveCpu" style="font-weight:700; margin:4px 0 0 0; color:var(--accent-primary);">-- %</h4>
            </div>
          </div>
          <div class="col-6">
            <div class="p-2 rounded text-center" style="background:rgba(0,0,0,0.3); border:1px solid var(--glass-border);">
              <small class="text-muted d-block" style="font-size:10px;">MEMORY USAGE</small>
              <h4 id="resLiveMem" style="font-weight:700; margin:4px 0 0 0; color:var(--accent-success);">-- MB</h4>
            </div>
          </div>
        </div>

        <form id="resourceForm" onsubmit="DockerPage.saveContainerResources(event)">
          <input type="hidden" id="resContainerId">
          <div class="lp-form-group mb-3">
            <label class="lp-label" style="font-size:11px; font-weight:600;">Memory Limit (MB) <small class="text-muted">(0 for unlimited)</small></label>
            <input type="number" id="resMemoryLimit" class="lp-input font-mono" placeholder="512" min="0">
          </div>
          <div class="lp-form-group mb-3">
            <label class="lp-label" style="font-size:11px; font-weight:600;">CPU Quota / Limit (Cores) <small class="text-muted">(e.g. 1, 2 or leave empty)</small></label>
            <input type="number" id="resNanoCpus" class="lp-input font-mono" placeholder="1" min="0" step="0.5">
          </div>
          <div class="lp-form-group mb-3">
            <label class="lp-label" style="font-size:11px; font-weight:600;">Restart Policy</label>
            <select id="resRestartPolicy" class="lp-input">
              <option value="unless-stopped">Unless Stopped</option>
              <option value="always">Always</option>
              <option value="on-failure">On Failure</option>
              <option value="no">No</option>
            </select>
          </div>
          <button type="submit" id="btnSaveResources" class="btn-lp btn-lp-primary w-100"><i class="bi bi-check2-circle me-1"></i> Apply Resource Limits</button>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- Log Viewer Modal -->
<div class="modal fade" id="logModal" tabindex="-1">
  <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title font-mono" style="font-size:13px" id="logModalTitle">Container Logs</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" onclick="DockerPage.detachLogs()"></button>
      </div>
      <div class="modal-body" style="padding:0;background:rgba(0,0,0,0.5);">
        <div id="logTerminal" style="width:100%;height:500px"></div>
      </div>
    </div>
  </div>
</div>

