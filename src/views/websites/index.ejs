<div class="lp-page-header" style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:20px;">
  <div>
    <h1 class="lp-page-title" style="font-size:24px;font-weight:600;margin:0;">Website Management</h1>
    <p class="lp-page-subtitle" style="color:var(--text-muted);margin:0;">Manage domains, vhosts, and runtimes</p>
  </div>
  <button class="btn-lp btn-lp-primary" onclick="WebsitesPage.showCreateModal()"><i class="bi bi-plus-lg"></i> Add Website</button>
</div>

<div class="lp-glass-card" style="padding:0;overflow-x:auto;">
  <table class="lp-table">
    <thead>
      <tr>
        <th>Domain</th>
        <th>Status</th>
        <th>Type</th>
        <th>Directory / Port</th>
        <th>SSL</th>
        <th style="text-align:right">Actions</th>
      </tr>
    </thead>
    <tbody id="websitesTableBody">
      <tr><td colspan="6" style="text-align:center;padding:20px;color:var(--text-muted)">Loading...</td></tr>
    </tbody>
  </table>
  <div id="websitesPagination" style="padding: 0 15px 15px 15px;"></div>
</div>

<!-- Create Modal -->
<div class="modal fade" id="createWebsiteModal" tabindex="-1" aria-labelledby="createWebsiteModalLabel" aria-modal="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="background:#1a1d2e;border:1px solid rgba(255,255,255,0.12);color:var(--text-primary);box-shadow:0 25px 60px rgba(0,0,0,0.6);">
      <div class="modal-header" style="border-bottom:1px solid rgba(255,255,255,0.1);padding:18px 22px;">
        <h5 class="modal-title font-mono" id="createWebsiteModalLabel" style="font-size:15px;font-weight:700;">
          <i class="bi bi-globe2 text-primary me-2"></i>Create Website
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="createWebsiteForm" onsubmit="WebsitesPage.createWebsite(event)">
        <div class="modal-body" style="padding:22px;">
          <div class="lp-form-group">
            <label class="lp-label">Domain Name</label>
            <input type="text" id="cwDomain" class="lp-input" placeholder="example.com" required>
          </div>
          <div class="lp-form-group">
            <label class="lp-label">Website Type</label>
            <select id="cwType" class="lp-input" required onchange="WebsitesPage.toggleTypeFields()">
              <option value="static">Static HTML</option>
              <option value="proxy">Reverse Proxy / Node.js</option>
              <option value="php">PHP</option>
            </select>
          </div>
          <div class="lp-form-group" id="cwDockerGroup" style="display:none">
            <label class="lp-label">Map to Docker Container (Optional)</label>
            <select id="cwDockerContainer" class="lp-input" onchange="WebsitesPage.onDockerSelected()">
              <option value="">-- Don't map (Manual port config) --</option>
            </select>
          </div>
          <div class="lp-form-group">
            <label class="lp-label">Document Root</label>
            <input type="text" id="cwRoot" class="lp-input" placeholder="/var/www/example.com">
            <div style="font-size:11px;color:var(--text-muted);margin-top:4px">Leave empty to use default (/var/www/domain)</div>
          </div>
          <div class="lp-form-group" id="cwPortGroup" style="display:none">
            <label class="lp-label">Proxy Target Port</label>
            <input type="number" id="cwPort" class="lp-input" placeholder="8080">
          </div>
          <div class="lp-form-group" id="cwPhpGroup" style="display:none">
            <label class="lp-label">PHP Version</label>
            <select id="cwPhpVersion" class="lp-input">
              <option value="7.2">PHP 7.2</option>
              <option value="7.3">PHP 7.3</option>
              <option value="7.4">PHP 7.4</option>
              <option value="8.0">PHP 8.0</option>
              <option value="8.1">PHP 8.1</option>
              <option value="8.2" selected>PHP 8.2</option>
              <option value="8.3">PHP 8.3</option>
              <option value="8.4">PHP 8.4</option>
              <option value="8.5">PHP 8.5</option>
            </select>
          </div>
          <div class="lp-form-group">
            <label class="lp-label">Git Repository <span style="color:var(--text-muted);font-size:11px;">(Optional)</span></label>
            <input type="text" id="cwGitRepo" class="lp-input" placeholder="https://github.com/user/repo.git">
          </div>
          <div style="display:flex;align-items:center;gap:10px;padding:10px 14px;background:rgba(255,255,255,0.03);border-radius:6px;border:1px solid rgba(255,255,255,0.07);">
            <input type="checkbox" id="cwAutoDeploy" style="accent-color:var(--primary-color);width:16px;height:16px;flex-shrink:0;">
            <label class="lp-label" style="margin:0;cursor:pointer;font-size:13px;" for="cwAutoDeploy">Enable Auto Deploy via Webhook</label>
          </div>
        </div>
        <div class="modal-footer" style="border-top:1px solid rgba(255,255,255,0.1);padding:16px 22px;">
          <button type="button" class="btn-lp btn-lp-ghost" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn-lp btn-lp-primary"><i class="bi bi-check2-circle me-1"></i> Create Website</button>
        </div>
      </form>
    </div>
  </div>
</div>


<!-- ============================================================
     EDIT WEBSITE MODAL (CENTERED & SOLID)
     ============================================================ -->
<div class="modal fade" id="editWebsiteModal" tabindex="-1" aria-labelledby="editWebsiteModalLabel" aria-modal="true">
  <div class="modal-dialog modal-dialog-centered modal-xl" style="max-width:920px;width:95%;">
    <div class="modal-content" style="background:#151824;border:1px solid rgba(255,255,255,0.14);border-radius:12px;box-shadow:0 25px 70px rgba(0,0,0,0.85);color:var(--text-primary);overflow:hidden;">
      <div class="modal-header" style="border-bottom:1px solid rgba(255,255,255,0.1);padding:18px 24px;background:#11131c;">
        <div>
          <h5 class="modal-title font-mono" id="editWebsiteModalLabel" style="font-weight:700;font-size:16px;margin:0;display:flex;align-items:center;gap:8px;">
            <i class="bi bi-pencil-square text-primary"></i> Edit Website
          </h5>
          <div id="editDrawerDomain" style="font-size:12px;color:var(--text-muted);margin-top:3px;font-family:var(--font-mono,monospace)"></div>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <!-- Tab Bar -->
      <div style="padding:0 24px;border-bottom:1px solid rgba(255,255,255,0.08);background:#131620;">
        <ul class="nav" id="editDrawerTabs" style="gap:4px;flex-wrap:nowrap;overflow-x:auto;">
          <li class="nav-item">
            <button class="ew-tab-btn active" data-target="etab-general" onclick="WebsitesPage.switchEditTab(this)" style="font-size:13px;padding:12px 18px;border:none;background:none;color:var(--text-muted);border-bottom:2px solid transparent;cursor:pointer;white-space:nowrap;transition:all .2s;">
              <i class="bi bi-gear me-1"></i> General
            </button>
          </li>
          <li class="nav-item">
            <button class="ew-tab-btn" data-target="etab-nginx" onclick="WebsitesPage.switchEditTab(this)" style="font-size:13px;padding:12px 18px;border:none;background:none;color:var(--text-muted);border-bottom:2px solid transparent;cursor:pointer;white-space:nowrap;transition:all .2s;">
              <i class="bi bi-file-earmark-code me-1"></i> Nginx Config
            </button>
          </li>
          <li class="nav-item">
            <button class="ew-tab-btn" data-target="etab-ssl" onclick="WebsitesPage.switchEditTab(this)" style="font-size:13px;padding:12px 18px;border:none;background:none;color:var(--text-muted);border-bottom:2px solid transparent;cursor:pointer;white-space:nowrap;transition:all .2s;">
              <i class="bi bi-shield-lock me-1"></i> SSL / HTTPS
            </button>
          </li>
          <li class="nav-item">
            <button class="ew-tab-btn" data-target="etab-git" onclick="WebsitesPage.switchEditTab(this)" style="font-size:13px;padding:12px 18px;border:none;background:none;color:var(--text-muted);border-bottom:2px solid transparent;cursor:pointer;white-space:nowrap;transition:all .2s;">
              <i class="bi bi-git me-1"></i> Git / Deploy
            </button>
          </li>
        </ul>
      </div>

      <div class="modal-body" style="padding:24px 28px;max-height:75vh;overflow-y:auto;background:#151824;">

    <!-- ---- TAB: General ---- -->
    <div id="etab-general" class="ew-tab-pane">
      <div class="lp-form-group">
        <label class="lp-label">Domain Name</label>
        <input type="text" id="editDomain" class="lp-input" placeholder="example.com">
      </div>
      <div class="lp-form-group">
        <label class="lp-label">Alias Domains <span style="font-size:11px;color:var(--text-muted)">(comma separated)</span></label>
        <input type="text" id="editAliases" class="lp-input" placeholder="www.example.com, alias.example.com">
      </div>
      <div class="lp-form-group">
        <label class="lp-label">Website Type</label>
        <select id="editType" class="lp-input" onchange="WebsitesPage.toggleEditTypeFields()">
          <option value="static">Static HTML</option>
          <option value="proxy">Reverse Proxy / Node.js</option>
          <option value="php">PHP</option>
        </select>
      </div>
      <div class="lp-form-group">
        <label class="lp-label">Document Root</label>
        <div style="display:flex;gap:8px;">
          <input type="text" id="editRoot" class="lp-input" placeholder="/var/www/example.com" style="flex:1;">
          <button class="btn-lp btn-lp-ghost btn-lp-sm" onclick="WebsitesPage.editOpenFolder()" title="Open in File Manager" style="padding:0 12px;"><i class="bi bi-folder2-open"></i></button>
        </div>
      </div>
      <div class="lp-form-group" id="editPortGroup" style="display:none;">
        <label class="lp-label">Proxy Target Port</label>
        <input type="number" id="editPort" class="lp-input" placeholder="8080">
      </div>
      <div class="lp-form-group" id="editPhpGroup" style="display:none;">
        <label class="lp-label">PHP Version</label>
        <select id="editPhpVersion" class="lp-input">
          <option value="7.2">PHP 7.2</option><option value="7.3">PHP 7.3</option><option value="7.4">PHP 7.4</option>
          <option value="8.0">PHP 8.0</option><option value="8.1">PHP 8.1</option><option value="8.2">PHP 8.2</option>
          <option value="8.3">PHP 8.3</option><option value="8.4">PHP 8.4</option><option value="8.5">PHP 8.5</option>
        </select>
      </div>

      <div style="padding:14px 16px;background:rgba(0,0,0,0.2);border-radius:8px;border:1px solid var(--border-color);margin-bottom:18px;display:flex;align-items:center;justify-content:space-between;">
        <div id="editStatusBadge"></div>
        <button class="btn-lp btn-lp-ghost btn-lp-sm" id="editToggleStatusBtn" onclick="WebsitesPage.toggleWebsiteStatus()" style="font-size:12px;"></button>
      </div>

      <div style="display:flex;gap:10px;">
        <button class="btn-lp btn-lp-primary" style="flex:1;" onclick="WebsitesPage.saveGeneralSettings()">
          <i class="bi bi-check2-circle me-1"></i> Save Changes
        </button>
        <button class="btn-lp btn-lp-ghost text-danger btn-lp-sm" onclick="WebsitesPage.deleteCurrentWebsite()" title="Delete Website">
          <i class="bi bi-trash"></i>
        </button>
      </div>
    </div>

    <!-- ---- TAB: Nginx Config ---- -->
    <div id="etab-nginx" class="ew-tab-pane" style="display:none;">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
        <div>
          <span class="text-muted font-mono" style="font-size:11px;" id="editNginxFilePath">/etc/nginx/conf.d/...</span>
        </div>
        <div id="editNginxBadge">
          <span class="badge bg-secondary" style="font-size:10px;">vhost config</span>
        </div>
      </div>
      <textarea id="editNginxEditor" class="form-control font-mono" rows="22"
        style="font-size:12px;background:#0d1117;color:#e6edf3;border:1px solid rgba(255,255,255,0.15);line-height:1.6;resize:vertical;font-family:'Fira Mono','Courier New',monospace;"
        spellcheck="false" placeholder="# Loading..."></textarea>
      <div style="font-size:11px;color:var(--text-muted);margin-top:8px;">
        <i class="bi bi-info-circle text-info"></i> Changes are syntax-checked with <code>nginx -t</code> before reloading. Custom configs are protected from auto-overwrite.
      </div>
      <div style="margin-top:14px;display:flex;gap:10px;">
        <button class="btn-lp btn-lp-primary" style="flex:1;" id="editSaveNginxBtn" onclick="WebsitesPage.saveDrawerNginxConfig()">
          <i class="bi bi-check2-circle me-1"></i> Save &amp; Reload Nginx
        </button>
        <button class="btn-lp btn-lp-ghost text-warning btn-lp-sm" id="editResetNginxBtn" onclick="WebsitesPage.resetDrawerNginxConfig()" title="Reset to default generated template">
          <i class="bi bi-arrow-counterclockwise me-1"></i> Reset Default
        </button>
      </div>
    </div>

    <!-- ---- TAB: SSL ---- -->
    <div id="etab-ssl" class="ew-tab-pane" style="display:none;">
      <div id="editSslStatusBanner" style="padding:14px 16px;border-radius:8px;margin-bottom:18px;background:rgba(255,255,255,0.04);border:1px solid var(--border-color);">
        <div style="display:flex;justify-content:space-between;align-items:center;">
          <div>
            <div style="font-size:11px;color:var(--text-muted)">Current SSL Status:</div>
            <div id="editSslStatusText" style="font-weight:600;font-size:14px;margin-top:2px;">Loading...</div>
          </div>
          <div id="editSslStatusBadge"></div>
        </div>
        <div id="editSslExpiryInfo" style="font-size:11px;color:var(--text-muted);margin-top:6px;"></div>
      </div>

      <div style="display:flex;gap:6px;margin-bottom:16px;flex-wrap:wrap;">
        <button class="btn-lp btn-lp-primary btn-lp-sm ssl-sub-btn" id="editSslTabLe" onclick="WebsitesPage.switchSslSubTab('letsencrypt')" style="font-size:12px;"><i class="bi bi-lock me-1"></i>Let's Encrypt</button>
        <button class="btn-lp btn-lp-ghost btn-lp-sm ssl-sub-btn" id="editSslTabSelf" onclick="WebsitesPage.switchSslSubTab('selfsigned')" style="font-size:12px;"><i class="bi bi-file-earmark-lock me-1"></i>Self-Signed</button>
        <button class="btn-lp btn-lp-ghost btn-lp-sm ssl-sub-btn" id="editSslTabCustom" onclick="WebsitesPage.switchSslSubTab('custom')" style="font-size:12px;"><i class="bi bi-upload me-1"></i>Custom PEM</button>
      </div>

      <div id="editSslPaneLe">
        <div style="font-size:12px;color:var(--text-muted);line-height:1.6;margin-bottom:12px;padding:10px 14px;background:rgba(13,110,253,0.07);border-radius:6px;border:1px solid rgba(13,110,253,0.2);">
          <i class="bi bi-info-circle text-info"></i> <strong>Requirement:</strong> Domain must resolve to this server's public IP and port 80 must be publicly reachable.
        </div>
        <button class="btn-lp btn-lp-primary w-100" id="editBtnLe" onclick="WebsitesPage.issueEditSSL('letsencrypt')">
          <i class="bi bi-shield-check me-1"></i> Issue Let's Encrypt SSL
        </button>
      </div>

      <div id="editSslPaneSelf" style="display:none;">
        <div style="font-size:12px;color:var(--text-muted);line-height:1.6;margin-bottom:12px;padding:10px 14px;background:rgba(255,193,7,0.07);border-radius:6px;border:1px solid rgba(255,193,7,0.2);">
          <i class="bi bi-lightning-charge text-warning"></i> <strong>Best for:</strong> Local IP, intranet, staging, or domains without public DNS. Browser will show a security notice.
        </div>
        <button class="btn-lp btn-lp-primary w-100" id="editBtnSelf" onclick="WebsitesPage.issueEditSSL('selfsigned')">
          <i class="bi bi-file-earmark-lock me-1"></i> Generate Self-Signed SSL
        </button>
      </div>

      <div id="editSslPaneCustom" style="display:none;">
        <div class="lp-form-group">
          <label class="lp-label" style="font-size:11px;">Certificate (fullchain.pem / crt)</label>
          <textarea id="editSslCert" class="lp-input font-mono" rows="4" style="font-size:11px;" placeholder="-----BEGIN CERTIFICATE-----..."></textarea>
        </div>
        <div class="lp-form-group">
          <label class="lp-label" style="font-size:11px;">Private Key (privkey.pem / key)</label>
          <textarea id="editSslKey" class="lp-input font-mono" rows="4" style="font-size:11px;" placeholder="-----BEGIN PRIVATE KEY-----..."></textarea>
        </div>
        <button class="btn-lp btn-lp-primary w-100" id="editBtnCustom" onclick="WebsitesPage.issueEditSSL('custom')">
          <i class="bi bi-check2-circle me-1"></i> Save &amp; Enable Custom SSL
        </button>
      </div>

      <div id="editSslDisable" style="margin-top:18px;padding-top:15px;border-top:1px solid var(--border-color);display:none;">
        <button class="btn-lp btn-lp-ghost text-danger w-100 btn-lp-sm" onclick="WebsitesPage.disableEditSSL()">
          <i class="bi bi-shield-x me-1"></i> Disable SSL (Revert to HTTP only)
        </button>
      </div>
    </div>

    <!-- ---- TAB: Git / Deploy ---- -->
    <div id="etab-git" class="ew-tab-pane" style="display:none;">
      <div class="lp-form-group">
        <label class="lp-label">Git Repository URL</label>
        <input type="text" id="editGitRepo" class="lp-input" placeholder="https://github.com/user/repo.git">
      </div>
      <div class="lp-form-group">
        <label class="lp-label">Deploy Branch</label>
        <input type="text" id="editGitBranch" class="lp-input" placeholder="main">
        <div style="font-size:11px;color:var(--text-muted);margin-top:4px;">Leave empty to use default branch</div>
      </div>
      <div class="lp-form-group" style="display:flex;align-items:center;gap:10px;">
        <input type="checkbox" id="editAutoDeploy" style="accent-color:var(--primary-color);width:16px;height:16px;">
        <label class="lp-label" style="margin:0;cursor:pointer;" for="editAutoDeploy">Enable Auto Deploy via Webhook</label>
      </div>

      <div id="editWebhookSection" style="display:none;margin-top:16px;padding:14px 16px;background:rgba(0,0,0,0.2);border-radius:8px;border:1px solid var(--border-color);">
        <div style="font-size:11px;color:var(--text-muted);margin-bottom:6px;font-weight:600;text-transform:uppercase;letter-spacing:.5px;">Webhook URL</div>
        <div style="display:flex;gap:8px;align-items:center;">
          <input type="text" id="editWebhookUrl" class="lp-input font-mono" style="font-size:11px;flex:1;" readonly>
          <button class="btn-lp btn-lp-ghost btn-lp-sm" onclick="WebsitesPage.copyWebhookUrl()" title="Copy"><i class="bi bi-clipboard"></i></button>
        </div>
        <div style="font-size:10px;color:var(--text-muted);margin-top:6px;">Set content type to <code>application/json</code> in your Git provider webhook settings.</div>
      </div>

      <div style="margin-top:16px;display:flex;gap:8px;">
        <button class="btn-lp btn-lp-primary" style="flex:1;" onclick="WebsitesPage.saveGeneralSettings()">
          <i class="bi bi-check2-circle me-1"></i> Save Git Settings
        </button>
        <button class="btn-lp btn-lp-ghost text-info btn-lp-sm" id="editDeployNowBtn" onclick="WebsitesPage.deployFromDrawer()" title="Deploy Now" style="display:none;">
          <i class="bi bi-cloud-arrow-down me-1"></i> Deploy Now
        </button>
      </div>
    </div>

      </div>
    </div>
  </div>
</div>

<style>
  .ew-tab-btn.active { color: var(--primary-color) !important; border-bottom-color: var(--primary-color) !important; }
  .ew-tab-btn:hover:not(.active) { color: var(--text-primary) !important; background: rgba(255,255,255,0.05); }
</style>


<script src="/js/websites.js?v=<%= Date.now() %>"></script>

