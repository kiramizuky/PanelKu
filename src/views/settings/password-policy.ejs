<div class="row g-4 align-items-start">
  <!-- Left Side: Navigation -->
  <div class="col-12 col-lg-4">
    <div class="settings-sidebar">
      <div class="settings-sidebar-header">
        <div style="position:relative; display:inline-block;">
          <div class="settings-avatar" style="margin:0 auto 10px;">
            <i class="bi bi-shield-lock-fill"></i>
          </div>
        </div>
        <h5 class="settings-sidebar-name">Password Policy</h5>
        <p class="settings-sidebar-sub">Security &amp; compliance settings</p>
      </div>

      <!-- Navigation List -->
      <div class="settings-nav">
        <a href="/settings/profile" class="settings-nav-item">
          <i class="bi bi-person-fill"></i> My Profile
        </a>
        <a href="/settings/users" class="settings-nav-item">
          <i class="bi bi-people"></i> Users
        </a>
        <a href="/settings/roles" class="settings-nav-item">
          <i class="bi bi-shield-lock"></i> Roles &amp; Permissions
        </a>
        <a href="/settings/auth" class="settings-nav-item">
          <i class="bi bi-key-fill"></i> SSO / LDAP
        </a>
        <a href="/settings/password-policy" class="settings-nav-item active">
          <i class="bi bi-lock-fill"></i> Password Policy
        </a>
        <a href="/settings/themes" class="settings-nav-item">
          <i class="bi bi-palette"></i> Themes
        </a>
        <a href="/settings/audit" class="settings-nav-item">
          <i class="bi bi-journal-text"></i> Audit Log
        </a>
        <a href="/settings/changelog" class="settings-nav-item">
          <i class="bi bi-file-earmark-text"></i> Changelog
        </a>
      </div>
    </div>
  </div>

  <!-- Right Side: Password Policy Configuration -->
  <div class="col-12 col-lg-8">
    <!-- Complexity Settings -->
    <div class="lp-glass-card mb-4" style="border-radius:16px; padding:25px;">
      <div style="display:flex; align-items:center; gap:15px; border-bottom:1px solid var(--glass-border); padding-bottom:15px; margin-bottom:20px;">
        <div style="width:44px; height:44px; border-radius:12px; background:rgba(255,255,255,0.05); display:flex; align-items:center; justify-content:center; font-size:20px;">
          <i class="bi bi-shield-check text-primary"></i>
        </div>
        <div style="flex:1;">
          <h5 style="font-weight:700; margin:0; color:var(--text-primary); font-size:15px;">Password Complexity Requirements</h5>
          <p style="color:var(--text-muted); margin:2px 0 0 0; font-size:11px;">Define rules users must follow when creating passwords</p>
        </div>
      </div>

      <!-- Live Preview -->
      <div style="background:rgba(0,0,0,0.2); border-radius:10px; padding:12px 16px; margin-bottom:20px; border:1px solid var(--glass-border);">
        <div style="font-size:11px; font-weight:600; color:var(--text-muted); margin-bottom:6px;">Current Policy Preview</div>
        <div id="policyPreview">
          <code style="background:rgba(255,255,255,0.05); padding:8px 12px; border-radius:6px; display:inline-block; font-size:12px;">min 12 chars, uppercase, lowercase, number, special char</code>
          <span style="margin-left:10px; font-size:12px; color:var(--text-secondary);">Expires in <strong>90d</strong>, reminder <strong>7d</strong> before</span>
        </div>
      </div>

      <div class="row g-4">
        <!-- Minimum Length -->
        <div class="col-12 col-md-4">
          <div class="lp-form-group mb-0">
            <label class="lp-label" style="font-size:11px; font-weight:600; color:var(--text-muted);">
              <i class="bi bi-123 me-1"></i> Minimum Length
            </label>
            <div style="position:relative;">
              <input type="number" id="policyMinLength" class="lp-input" min="6" max="128" value="12" oninput="PasswordPolicyPage._updatePreview()" style="text-align:center; font-weight:700; font-size:16px;">
            </div>
            <small style="font-size:10px; color:var(--text-muted); margin-top:4px; display:block;">OWASP recommends 12+</small>
          </div>
        </div>

        <!-- Expiry Days -->
        <div class="col-12 col-md-4">
          <div class="lp-form-group mb-0">
            <label class="lp-label" style="font-size:11px; font-weight:600; color:var(--text-muted);">
              <i class="bi bi-calendar-event me-1"></i> Expiry (Days)
            </label>
            <div style="position:relative;">
              <input type="number" id="policyExpiryDays" class="lp-input" min="1" max="365" value="90" oninput="PasswordPolicyPage._updatePreview()" style="text-align:center; font-weight:700; font-size:16px;">
            </div>
            <small style="font-size:10px; color:var(--text-muted); margin-top:4px; display:block;">Force change after N days</small>
          </div>
        </div>

        <!-- Reminder Days -->
        <div class="col-12 col-md-4">
          <div class="lp-form-group mb-0">
            <label class="lp-label" style="font-size:11px; font-weight:600; color:var(--text-muted);">
              <i class="bi bi-bell me-1"></i> Reminder Before
            </label>
            <div style="position:relative;">
              <input type="number" id="policyReminderDays" class="lp-input" min="1" max="90" value="7" oninput="PasswordPolicyPage._updatePreview()" style="text-align:center; font-weight:700; font-size:16px;">
            </div>
            <small style="font-size:10px; color:var(--text-muted); margin-top:4px; display:block;">Send reminder N days before expiry</small>
          </div>
        </div>
      </div>

      <!-- Complexity Toggles -->
      <div style="border-top:1px solid var(--glass-border); padding-top:20px; margin-top:20px;">
        <div class="row g-3">
          <div class="col-6 col-md-3">
            <label class="d-flex align-items-center gap-2" style="cursor:pointer; padding:12px; border-radius:10px; background:rgba(0,0,0,0.2); border:1px solid var(--glass-border); transition:border-color 0.2s;" onmouseover="this.style.borderColor='var(--accent-primary)'" onmouseout="this.style.borderColor='var(--glass-border)'">
              <input type="checkbox" id="policyRequireUppercase" checked onchange="PasswordPolicyPage._updatePreview()" style="width:18px; height:18px; cursor:pointer;">
              <div>
                <strong style="font-size:12px; display:block;">A-Z</strong>
                <small style="font-size:10px; color:var(--text-muted);">Uppercase</small>
              </div>
            </label>
          </div>
          <div class="col-6 col-md-3">
            <label class="d-flex align-items-center gap-2" style="cursor:pointer; padding:12px; border-radius:10px; background:rgba(0,0,0,0.2); border:1px solid var(--glass-border); transition:border-color 0.2s;" onmouseover="this.style.borderColor='var(--accent-primary)'" onmouseout="this.style.borderColor='var(--glass-border)'">
              <input type="checkbox" id="policyRequireLowercase" checked onchange="PasswordPolicyPage._updatePreview()" style="width:18px; height:18px; cursor:pointer;">
              <div>
                <strong style="font-size:12px; display:block;">a-z</strong>
                <small style="font-size:10px; color:var(--text-muted);">Lowercase</small>
              </div>
            </label>
          </div>
          <div class="col-6 col-md-3">
            <label class="d-flex align-items-center gap-2" style="cursor:pointer; padding:12px; border-radius:10px; background:rgba(0,0,0,0.2); border:1px solid var(--glass-border); transition:border-color 0.2s;" onmouseover="this.style.borderColor='var(--accent-primary)'" onmouseout="this.style.borderColor='var(--glass-border)'">
              <input type="checkbox" id="policyRequireNumber" checked onchange="PasswordPolicyPage._updatePreview()" style="width:18px; height:18px; cursor:pointer;">
              <div>
                <strong style="font-size:12px; display:block;">0-9</strong>
                <small style="font-size:10px; color:var(--text-muted);">Digits</small>
              </div>
            </label>
          </div>
          <div class="col-6 col-md-3">
            <label class="d-flex align-items-center gap-2" style="cursor:pointer; padding:12px; border-radius:10px; background:rgba(0,0,0,0.2); border:1px solid var(--glass-border); transition:border-color 0.2s;" onmouseover="this.style.borderColor='var(--accent-primary)'" onmouseout="this.style.borderColor='var(--glass-border)'">
              <input type="checkbox" id="policyRequireSpecial" checked onchange="PasswordPolicyPage._updatePreview()" style="width:18px; height:18px; cursor:pointer;">
              <div>
                <strong style="font-size:12px; display:block;">!#?</strong>
                <small style="font-size:10px; color:var(--text-muted);">Special</small>
              </div>
            </label>
          </div>
        </div>
      </div>

      <!-- Expiry Toggle -->
      <div style="border-top:1px solid var(--glass-border); padding-top:20px; margin-top:20px;">
        <div class="d-flex align-items-center justify-content-between p-3 rounded" style="background:rgba(0,0,0,0.2); border:1px solid var(--glass-border);">
          <div>
            <strong style="font-size:13px; color:var(--text-primary);"><i class="bi bi-clock-history me-2 text-warning"></i>Password Expiry</strong>
            <p style="font-size:11px; color:var(--text-muted); margin:4px 0 0 0;">Force users to change passwords after a configurable period</p>
          </div>
          <div class="form-check form-switch mb-0">
            <input class="form-check-input" type="checkbox" id="policyExpiryEnabled" checked onchange="PasswordPolicyPage._updatePreview()" style="width:40px; height:20px; cursor:pointer;">
          </div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div style="display:flex; gap:10px; margin-top:20px; padding-top:20px; border-top:1px solid var(--glass-border); flex-wrap:wrap;">
        <button class="btn-lp btn-lp-primary flex-fill" onclick="PasswordPolicyPage.save()" id="btnSavePolicy" style="padding:10px; font-weight:600; font-size:13px; min-width:120px;">
          <i class="bi bi-check2-circle me-1"></i> Save Policy
        </button>
        <button class="btn-lp btn-lp-ghost" onclick="PasswordPolicyPage.reset()" id="btnResetPolicy" style="padding:10px 16px; font-weight:600; font-size:12px;">
          <i class="bi bi-arrow-counterclockwise me-1"></i> Reset to Defaults
        </button>
        <button class="btn-lp btn-lp-info" onclick="PasswordPolicyPage.exportJSON()" style="padding:10px 16px; font-weight:600; font-size:12px;">
          <i class="bi bi-download me-1"></i> Export JSON
        </button>
        <button class="btn-lp btn-lp-info" onclick="PasswordPolicyPage.importJSON()" style="padding:10px 16px; font-weight:600; font-size:12px;">
          <i class="bi bi-upload me-1"></i> Import JSON
        </button>
      </div>
    </div>

    <!-- Import from Remote URL -->
    <div class="lp-glass-card mb-4" style="border-radius:16px; padding:25px;">
      <div style="display:flex; align-items:center; gap:15px; border-bottom:1px solid var(--glass-border); padding-bottom:15px; margin-bottom:20px;">
        <div style="width:44px; height:44px; border-radius:12px; background:rgba(255,255,255,0.05); display:flex; align-items:center; justify-content:center; font-size:20px;">
          <i class="bi bi-cloud-download text-info"></i>
        </div>
        <div style="flex:1;">
          <h5 style="font-weight:700; margin:0; color:var(--text-primary); font-size:15px;">Import from Remote Server</h5>
          <p style="color:var(--text-muted); margin:2px 0 0 0; font-size:11px;">Fetch password policy from another Panelku server's export endpoint</p>
        </div>
      </div>

      <div class="row g-3 align-items-end">
        <div class="col-12 col-md-8">
          <div class="lp-form-group mb-0">
            <label class="lp-label" style="font-size:11px; font-weight:600; color:var(--text-muted);">Source URL</label>
            <input type="url" id="remoteUrlInput" class="lp-input font-mono" placeholder="https://panel2.example.com/api/system/password-policy/export" onkeydown="if(event.key==='Enter') PasswordPolicyPage.fetchFromUrl()">
          </div>
        </div>
        <div class="col-12 col-md-4">
          <button class="btn-lp btn-lp-info w-100" onclick="PasswordPolicyPage.fetchFromUrl()" id="btnFetchUrl" style="padding:10px; font-weight:600; font-size:13px;">
            <i class="bi bi-cloud-download me-1"></i> Fetch from URL
          </button>
        </div>
      </div>
      <!-- Preview container (hidden by default) -->
      <div id="urlPreviewContainer" style="display:none;"></div>
    </div>

    <!-- Password Test Tool -->
    <div class="lp-glass-card" style="border-radius:16px; padding:25px;">
      <div style="display:flex; align-items:center; gap:15px; border-bottom:1px solid var(--glass-border); padding-bottom:15px; margin-bottom:20px;">
        <div style="width:44px; height:44px; border-radius:12px; background:rgba(255,255,255,0.05); display:flex; align-items:center; justify-content:center; font-size:20px;">
          <i class="bi bi-flask text-success"></i>
        </div>
        <div style="flex:1;">
          <h5 style="font-weight:700; margin:0; color:var(--text-primary); font-size:15px;">Test Password Against Policy</h5>
          <p style="color:var(--text-muted); margin:2px 0 0 0; font-size:11px;">Verify a sample password meets the current requirements</p>
        </div>
      </div>

      <div class="row g-3 align-items-end">
        <div class="col-12 col-md-8">
          <div class="lp-form-group mb-0">
            <input type="text" id="testPassword" class="lp-input font-mono" placeholder="Type a password to test..." onkeydown="if(event.key==='Enter') PasswordPolicyPage.testPassword()">
          </div>
        </div>
        <div class="col-12 col-md-4">
          <button class="btn-lp btn-lp-primary w-100" onclick="PasswordPolicyPage.testPassword()" style="padding:10px; font-weight:600; font-size:13px;">
            <i class="bi bi-check-lg me-1"></i> Test Password
          </button>
        </div>
      </div>
      <div id="testPasswordResult" style="display:none;"></div>
    </div>

    <!-- Info Card -->
    <div class="lp-glass-card mt-4" style="border-radius:16px; padding:25px; background:rgba(59,130,246,0.05); border:1px solid rgba(59,130,246,0.15);">
      <div class="d-flex align-items-start gap-3">
        <i class="bi bi-info-circle-fill text-primary" style="font-size:20px; flex-shrink:0; margin-top:2px;"></i>
        <div>
          <h6 style="font-weight:600; color:var(--text-primary); margin:0 0 6px 0; font-size:13px;">About Password Policy Configuration</h6>
          <ul style="font-size:11.5px; color:var(--text-secondary); margin:0; padding-left:16px; line-height:1.8;">
            <li><strong>Minimum Length</strong> — Set between 6 and 128 characters. OWASP 2023 recommends at least 12.</li>
            <li><strong>Complexity</strong> — Toggle which character types are required: uppercase, lowercase, digits, and special characters.</li>
            <li><strong>Password Expiry</strong> — When enabled, users must change their password every N days. A reminder is sent N days before expiry via in-app notification and email (if SMTP is configured).</li>
            <li><strong>Existing Users</strong> — Policy applies to new passwords set after configuration. Existing passwords remain valid until their next change.</li>
            <li><strong>Default Admin</strong> — The default admin account is always forced to change password on first login regardless of this policy.</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="/js/settings/password-policy.js?v=<%= Date.now() %>"></script>
