<div class="row g-4 align-items-start">
  <!-- Left Side: Navigation -->
  <div class="col-12 col-lg-4">
    <div class="settings-sidebar">
      <div class="settings-sidebar-header">
        <div style="position:relative; display:inline-block;">
          <div class="settings-avatar" style="margin:0 auto 10px;">
            <i class="bi bi-clock-history"></i>
          </div>
        </div>
        <h5 class="settings-sidebar-name">Policy History</h5>
        <p class="settings-sidebar-sub">Change log with diff view</p>
      </div>

      <!-- Navigation List -->
      <div class="settings-nav">
        <a href="/settings/profile" class="settings-nav-item">
          <i class="bi bi-person-fill"></i> My Profile
        </a>
        <a href="/settings/users" class="settings-nav-item">
          <i class="bi bi-people"></i> Users
        </a>
        <a href="/settings/roles" class="settings-nav-item">
          <i class="bi bi-shield-lock"></i> Roles &amp; Permissions
        </a>
        <a href="/settings/auth" class="settings-nav-item">
          <i class="bi bi-key-fill"></i> SSO / LDAP
        </a>
        <a href="/settings/password-policy" class="settings-nav-item">
          <i class="bi bi-lock-fill"></i> Password Policy
        </a>
        <a href="/settings/password-policy-history" class="settings-nav-item active">
          <i class="bi bi-clock-history"></i> Policy History
        </a>
        <a href="/settings/themes" class="settings-nav-item">
          <i class="bi bi-palette"></i> Themes
        </a>
        <a href="/settings/audit" class="settings-nav-item">
          <i class="bi bi-journal-text"></i> Audit Log
        </a>
        <a href="/settings/changelog" class="settings-nav-item">
          <i class="bi bi-file-earmark-text"></i> Changelog
        </a>
      </div>
    </div>
  </div>

  <!-- Right Side: History Timeline -->
  <div class="col-12 col-lg-8">
    <div class="lp-glass-card" style="border-radius:16px; padding:25px;">
      <div style="display:flex; align-items:center; gap:15px; border-bottom:1px solid var(--glass-border); padding-bottom:15px; margin-bottom:20px;">
        <div style="width:44px; height:44px; border-radius:12px; background:rgba(255,255,255,0.05); display:flex; align-items:center; justify-content:center; font-size:20px;">
          <i class="bi bi-arrow-left-right text-primary"></i>
        </div>
        <div style="flex:1;">
          <h5 style="font-weight:700; margin:0; color:var(--text-primary); font-size:15px;">Password Policy Change History</h5>
          <p style="color:var(--text-muted); margin:2px 0 0 0; font-size:11px;">Timeline of all policy modifications with before/after comparison</p>
        </div>
        <button class="btn-lp btn-lp-ghost" onclick="PolicyHistoryPage.load()" title="Refresh" style="width:36px; padding:0; height:36px;">
          <i class="bi bi-arrow-clockwise"></i>
        </button>
      </div>

      <!-- History Timeline Container -->
      <div id="historyTimeline" style="min-height: 200px;">
        <div class="text-center py-5">
          <span class="spinner-border spinner-border-sm me-2" style="width:14px; height:14px;"></span>
          <span style="color:var(--text-muted); font-size:13px;">Loading history...</span>
        </div>
      </div>

      <!-- Link to full audit log -->
      <div style="border-top:1px solid var(--glass-border); padding-top:16px; margin-top:16px; text-align:center;">
        <a href="/settings/audit?filter=password_policy" class="btn-lp btn-lp-ghost" style="font-size:12px; padding:8px 16px; display:inline-flex; align-items:center; gap:6px;">
          <i class="bi bi-journal-text"></i>
          View All Policy Changes in Audit Log
          <i class="bi bi-box-arrow-up-right" style="font-size:10px;"></i>
        </a>
      </div>
    </div>
  </div>
</div>

<script src="/js/settings/password-policy-history.js?v=<%= Date.now() %>"></script>
