<div class="row g-4 align-items-start">
  <!-- Left Side: Navigation & Profile Card (Unified) -->
  <div class="col-12 col-lg-4">
    <div class="settings-sidebar">
      <!-- Header Banner / Profile Area -->
      <div class="settings-sidebar-header">
        <!-- Avatar Ring -->
        <div style="position:relative; display:inline-block;">
          <div class="settings-avatar" style="margin:0 auto 10px;">
            <i class="bi bi-person"></i>
          </div>
          <span class="position-absolute bottom-0 end-0 p-1 bg-success border border-dark rounded-circle" style="width:10px; height:10px;" title="Online Status"></span>
        </div>
        <h5 id="profileCardName" class="settings-sidebar-name">Loading...</h5>
        <p id="profileCardEmail" class="settings-sidebar-sub">Loading...</p>
        <span id="profileCardBadge" class="lp-badge lp-badge-success" style="text-transform:uppercase; font-size:9px; font-weight:600; padding:4px 8px; border-radius:8px;">ROLE</span>
      </div>

      <!-- Navigation List -->
      <div class="settings-nav">
        <a href="/settings/profile" class="settings-nav-item">
          <i class="bi bi-person"></i> My Profile
        </a>
        <a href="/settings/users" class="settings-nav-item active">
          <i class="bi bi-people-fill"></i> Users
        </a>
        <a href="/settings/roles" class="settings-nav-item">
          <i class="bi bi-shield-lock"></i> Roles &amp; Permissions
        </a>
        <a href="/settings/password-policy" class="settings-nav-item">
          <i class="bi bi-lock-fill"></i> Password Policy
        </a>
        <a href="/settings/themes" class="settings-nav-item">
          <i class="bi bi-palette"></i> Themes
        </a>
        <a href="/settings/audit" class="settings-nav-item">
          <i class="bi bi-journal-text"></i> Audit Log
        </a>
        <a href="/settings/changelog" class="settings-nav-item">
          <i class="bi bi-file-earmark-text"></i> Changelog
        </a>
      </div>
    </div>
  </div>

  <div class="col-12 col-lg-8">
    <div class="lp-glass-card">
      <div class="lp-card-header" style="border-bottom:1px solid var(--glass-border);display:flex;justify-content:space-between;align-items:center;padding-bottom:15px;margin-bottom:15px;">
        <h3 class="lp-card-title m-0">User Management</h3>
        <button class="btn-lp btn-lp-primary btn-lp-sm" onclick="UsersPage.showCreateModal()"><i class="bi bi-person-plus"></i> Add User</button>
      </div>
      <div class="lp-card-body" style="padding:0;overflow-x:auto;">
        <table class="lp-table">
          <thead>
            <tr>
              <th>Username</th>
              <th>Email</th>
              <th>Role</th>
              <th>Status</th>
              <th style="text-align:right">Actions</th>
            </tr>
          </thead>
          <tbody id="usersTableBody">
            <tr><td colspan="5" style="text-align:center;color:var(--text-muted);padding:20px;">Loading...</td></tr>
          </tbody>
        </table>
        <div id="usersPagination" style="padding: 0 15px 15px 15px;"></div>
      </div>
    </div>
  </div>
</div>

<!-- Add/Edit User Modal -->
<div class="modal fade" id="userModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="background: #1e222d; border: 1px solid rgba(255,255,255,0.12); border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.6); color: #fff;">
      <div class="modal-header" style="border-bottom: 1px solid rgba(255,255,255,0.08); padding: 16px 20px;">
        <h5 class="modal-title font-mono" id="userModalTitle" style="font-size:14px; font-weight:600;"><i class="bi bi-person-fill-gear text-primary me-1"></i> Add User</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <form id="userForm" onsubmit="UsersPage.saveUser(event)">
        <div class="modal-body" style="padding: 20px;">
          <input type="hidden" id="userId">
          <div class="lp-form-group mb-3">
            <label class="lp-label mb-1" style="font-size:12px; font-weight:600;">Username</label>
            <input type="text" id="username" class="lp-input" placeholder="e.g. johndoe" required autocomplete="off">
          </div>
          <div class="lp-form-group mb-3">
            <label class="lp-label mb-1" style="font-size:12px; font-weight:600;">Email</label>
            <input type="email" id="email" class="lp-input" placeholder="e.g. john@example.com" required autocomplete="off">
          </div>
          <div class="lp-form-group mb-3" id="passwordGroup">
            <div class="d-flex justify-content-between align-items-center mb-1">
              <label class="lp-label m-0" style="font-size:12px; font-weight:600;">Password</label>
              <button type="button" class="btn btn-sm btn-link p-0 text-info text-decoration-none" style="font-size:11px" onclick="UsersPage.generatePassword()">
                <i class="bi bi-key-fill"></i> Generate Strong Password
              </button>
            </div>
            <div class="input-group">
              <input type="password" id="password" class="lp-input" style="border-top-right-radius:0;border-bottom-right-radius:0;" autocomplete="new-password">
              <button class="btn btn-outline-secondary" type="button" id="togglePasswordBtn" onclick="UsersPage.togglePasswordVisibility()" style="border-color:rgba(255,255,255,0.15);color:#adb5bd;" title="Show/Hide Password">
                <i class="bi bi-eye" id="passwordEyeIcon"></i>
              </button>
            </div>
            <small class="text-muted d-block mt-1" style="font-size:11px; line-height:1.4;" id="passwordHelp">
              Min. 12 characters, including uppercase, lowercase, number, and special character.
            </small>
          </div>
          <div class="lp-form-group mb-3">
            <label class="lp-label mb-1" style="font-size:12px; font-weight:600;">Role</label>
            <select id="role" class="lp-input" required></select>
          </div>
          <div class="lp-form-group mb-2">
            <label class="lp-label mb-1" style="font-size:12px; font-weight:600;">Status</label>
            <select id="status" class="lp-input">
              <option value="active">Active</option>
              <option value="inactive">Inactive</option>
            </select>
          </div>
        </div>
        <div class="modal-footer" style="border-top: 1px solid rgba(255,255,255,0.08); padding: 14px 20px;">
          <button type="button" class="btn-lp btn-lp-ghost" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn-lp btn-lp-primary" id="saveUserBtn"><i class="bi bi-check2-circle"></i> Save</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="/js/settings/users.js"></script>
