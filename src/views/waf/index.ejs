<div class="lp-page-header" style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:20px;">
  <div>
    <h1 class="lp-page-title" style="font-size:24px;font-weight:600;margin:0;">Web Application Firewall (WAF)</h1>
    <p class="lp-page-subtitle" style="color:var(--text-muted);margin:0;">Manage IP blacklists and security rules</p>
  </div>
  <button class="btn-lp btn-lp-primary" onclick="WAFPage.showAddModal()"><i class="bi bi-shield-plus"></i> Add Rule</button>
</div>

<!-- Security Advisor Card -->
<div class="lp-glass-card p-4 mb-4" style="border-radius:16px;">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h5 style="font-weight:700; margin:0; color:var(--text-primary);"><i class="bi bi-shield-lock-fill me-2 text-info"></i>Security Advisor</h5>
    <button class="btn-lp btn-lp-ghost btn-lp-sm text-primary" onclick="WAFPage.scanSecurity()"><i class="bi bi-arrow-clockwise"></i> Scan Now</button>
  </div>
  
  <div class="row g-4 align-items-center">
    <!-- Score Gauge -->
    <div class="col-12 col-md-3 text-center" style="border-right: 1px solid var(--glass-border);">
      <div style="position:relative; display:inline-block;">
        <div id="securityScoreRing" style="width: 100px; height: 100px; border-radius: 50%; border: 8px solid var(--glass-border); display: flex; align-items: center; justify-content: center; margin: 0 auto; transition: border-color 0.5s;">
          <h2 id="securityScoreText" style="font-weight: 700; margin: 0; color: #fff;">--</h2>
        </div>
      </div>
      <p class="text-muted mt-2 mb-0" style="font-size:12px;">Security Health Score</p>
    </div>
    
    <!-- Issues List -->
    <div class="col-12 col-md-9">
      <div id="securityAdvisorList" style="display:flex; flex-direction:column; gap:10px; max-height:180px; overflow-y:auto;">
        <p class="text-muted mb-0" style="font-size:13px;">Scanning system security configuration...</p>
      </div>
    </div>
  </div>
</div>

<!-- Navigation Tabs -->
<ul class="nav nav-tabs mb-4 dk-tabs">
  <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#waf-rules"><i class="bi bi-shield-check me-1"></i> WAF Rules &amp; Intrusion Logs</a></li>
  <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#waf-threat-map" onclick="WAFPage.loadThreatMap()"><i class="bi bi-globe-americas me-1 text-danger"></i> Real-time Threat Map &amp; Geo-Shield</a></li>
</ul>

<div class="tab-content">
  <!-- WAF Rules & Logs Tab -->
  <div class="tab-pane fade show active" id="waf-rules">
    <div class="row g-4">
      <!-- Left Side: WAF Rules -->
      <div class="col-12 col-xl-7">
        <div class="lp-glass-card" style="padding:0;overflow-x:auto;">
          <table class="lp-table">
            <thead>
              <tr>
                <th>Type</th>
                <th>Value</th>
                <th>Action</th>
                <th>Description</th>
                <th style="text-align:right">Options</th>
              </tr>
            </thead>
            <tbody id="wafTableBody">
              <tr><td colspan="5" style="text-align:center;padding:20px;color:var(--text-muted)">Loading...</td></tr>
            </tbody>
          </table>
          <div id="wafPagination" style="padding: 0 15px 15px 15px;"></div>
        </div>
      </div>

      <!-- Right Side: Fail2Ban Logs -->
      <div class="col-12 col-xl-5">
        <div class="lp-glass-card" style="padding:25px; display:flex; flex-direction:column; height:100%; min-height:400px;">
          <div style="border-bottom:1px solid var(--glass-border); padding-bottom:12px; margin-bottom:15px; display:flex; justify-content:space-between; align-items:center;">
            <h5 style="font-weight:700; margin:0; color:var(--text-primary); font-size:14px;"><i class="bi bi-activity me-2 text-danger"></i>Fail2Ban Intrusion Logs</h5>
            <div style="display:flex; gap:6px;">
              <button class="btn-lp btn-lp-ghost btn-lp-sm text-primary" onclick="WAFPage.askAILog()" style="font-size:11px; padding:4px 8px;" title="Analyze logs with AI"><i class="bi bi-robot"></i> Ask AI</button>
              <button class="btn-lp btn-lp-ghost btn-lp-sm" onclick="WAFPage.loadFail2BanLogs()" style="font-size:11px; padding:4px 8px;"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
            </div>
          </div>
          <div style="flex:1; background:rgba(0,0,0,0.25); border:1px solid var(--glass-border); border-radius:10px; padding:15px; font-family:monospace; font-size:11.5px; overflow-y:auto; max-height: 400px; color: var(--text-secondary);">
            <pre id="fail2banLogs" style="margin:0; white-space:pre-wrap; word-break:break-all; line-height:1.5;">Loading logs...</pre>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Real-Time GeoIP Threat Map & Geo-Shield Tab -->
  <div class="tab-pane fade" id="waf-threat-map">
    <!-- Stat Cards -->
    <div class="row g-3 mb-4">
      <div class="col-6 col-md-3">
        <div class="lp-glass-card p-3 text-center">
          <small class="text-muted d-block" style="font-size:11px;">TOTAL DETECTED THREATS</small>
          <h3 id="tmTotalThreats" style="font-weight:700; margin:4px 0 0 0; color:var(--accent-danger);">--</h3>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="lp-glass-card p-3 text-center">
          <small class="text-muted d-block" style="font-size:11px;">ATTACKER IPS</small>
          <h3 id="tmUniqueIps" style="font-weight:700; margin:4px 0 0 0; color:var(--accent-warning);">--</h3>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="lp-glass-card p-3 text-center">
          <small class="text-muted d-block" style="font-size:11px;">TOP ATTACK ORIGIN</small>
          <h3 id="tmTopCountry" style="font-weight:700; margin:4px 0 0 0; color:var(--accent-primary); font-size:20px;">--</h3>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="lp-glass-card p-3 text-center">
          <small class="text-muted d-block" style="font-size:11px;">BLOCKED COUNTRIES</small>
          <h3 id="tmBlockedCount" style="font-weight:700; margin:4px 0 0 0; color:var(--accent-info);">--</h3>
        </div>
      </div>
    </div>

    <!-- Country Geo-Shield Block Action Bar -->
    <div class="lp-glass-card p-3 mb-4 d-flex justify-content-between align-items-center flex-wrap gap-3" style="border-radius:14px;">
      <div style="display:flex; align-items:center; gap:10px;">
        <i class="bi bi-shield-slash-fill text-danger fs-4"></i>
        <div>
          <h6 style="margin:0; font-weight:700; font-size:13px; color:#fff;">1-Click Geo-Shield Country Blocker</h6>
          <small class="text-muted" style="font-size:11px;">Block all incoming HTTP/HTTPS and SSH traffic from selected countries</small>
        </div>
      </div>
      <div class="d-flex gap-2 align-items-center">
        <select id="geoBlockCountrySelect" class="lp-input font-mono" style="width:200px; height:36px; font-size:12px;">
          <option value="">-- Choose Country --</option>
        </select>
        <button class="btn-lp btn-lp-danger btn-lp-sm" onclick="WAFPage.submitGeoBlock()"><i class="bi bi-shield-x me-1"></i> Block Country</button>
      </div>
    </div>

    <div class="row g-4">
      <!-- Left: Top Attacking Countries List -->
      <div class="col-12 col-lg-5">
        <div class="lp-glass-card p-3" style="border-radius:14px;">
          <h6 style="font-weight:700; font-size:13px; margin-bottom:15px; color:#fff;"><i class="bi bi-bar-chart-fill me-2 text-primary"></i>Top Attack Origins (by Country)</h6>
          <div id="tmCountryBars" style="display:flex; flex-direction:column; gap:12px;">
            <p class="text-muted" style="font-size:12px;">Loading country statistics...</p>
          </div>
        </div>
      </div>

      <!-- Right: Threat Activity Feed -->
      <div class="col-12 col-lg-7">
        <div class="lp-glass-card p-0" style="border-radius:14px; overflow:hidden;">
          <div class="p-3 border-bottom" style="border-color:var(--glass-border) !important; display:flex; justify-content:space-between; align-items:center;">
            <h6 style="font-weight:700; font-size:13px; margin:0; color:#fff;"><i class="bi bi-radar me-2 text-danger"></i>Recent Blocked Attack Feed</h6>
            <span class="lp-badge lp-badge-danger" style="font-size:10px;">LIVE MONITOR</span>
          </div>
          <div style="max-height:360px; overflow-y:auto;">
            <table class="lp-table mb-0" style="font-size:12px;">
              <thead>
                <tr>
                  <th>Attacker IP</th>
                  <th>Country</th>
                  <th>Hits</th>
                  <th>Status</th>
                  <th style="text-align:right">Action</th>
                </tr>
              </thead>
              <tbody id="tmThreatsTableBody">
                <tr><td colspan="5" class="text-center text-muted py-3">Loading threat events...</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Add Rule Modal -->
<div class="modal fade" id="addRuleModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title font-mono" style="font-size:14px">Add WAF Rule</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <form id="addRuleForm" onsubmit="WAFPage.addRule(event)">
        <div class="modal-body">
          <div class="lp-form-group">
            <label class="lp-label">Type</label>
            <select id="ruleType" class="lp-input" required>
              <option value="ip">IP Address</option>
              <option value="country">Country (ISO Code)</option>
              <option value="user_agent">User Agent (Regex)</option>
            </select>
          </div>
          <div class="lp-form-group">
            <label class="lp-label">Value</label>
            <input type="text" id="ruleValue" class="lp-input" placeholder="e.g. 192.168.1.100" required>
          </div>
          <div class="lp-form-group">
            <label class="lp-label">Action</label>
            <select id="ruleAction" class="lp-input" required>
              <option value="block">Block</option>
              <option value="allow">Allow (Whitelist)</option>
            </select>
          </div>
          <div class="lp-form-group">
            <label class="lp-label">Description (Optional)</label>
            <input type="text" id="ruleDescription" class="lp-input" placeholder="e.g. Blocked bad bot">
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn-lp btn-lp-ghost" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn-lp btn-lp-primary">Add Rule</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="/js/waf.js"></script>

