<div class="lp-page-header" style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:20px;">
  <div>
    <h1 class="lp-page-title" style="font-size:24px;font-weight:600;margin:0;">SSL Certificates</h1>
    <p class="lp-page-subtitle" style="color:var(--text-muted);margin:0;">Manage Let's Encrypt certificates for domains</p>
  </div>
  <button class="btn-lp btn-lp-primary" onclick="SSLPage.showIssueModal()"><i class="bi bi-shield-lock"></i> Issue Certificate</button>
</div>

<div class="lp-glass-card" style="padding:0;overflow-x:auto;">
  <table class="lp-table">
    <thead>
      <tr>
        <th>Domain</th>
        <th>Provider</th>
        <th>Expires At</th>
        <th>Status</th>
        <th style="text-align:right">Actions</th>
      </tr>
    </thead>
    <tbody id="sslTableBody">
      <tr><td colspan="5" style="text-align:center;padding:20px;color:var(--text-muted)">Loading...</td></tr>
    </tbody>
  </table>
  <div id="sslPagination" style="padding: 0 15px 15px 15px;"></div>
</div>

<!-- Issue SSL Modal -->
<div class="modal fade" id="issueSslModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content" style="background:var(--bg-card);border:1px solid var(--border-color);color:var(--text-primary);">
      <div class="modal-header">
        <h5 class="modal-title font-mono" style="font-size:14px"><i class="bi bi-shield-lock"></i> Issue SSL Certificate</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <form id="issueSslForm" onsubmit="SSLPage.issueCertificate(event)">
        <div class="modal-body">
          <div class="lp-form-group">
            <label class="lp-label">Select Website</label>
            <select id="sslWebsiteId" class="lp-input" required>
              <option value="">Loading websites...</option>
            </select>
          </div>
          <div class="lp-form-group">
            <label class="lp-label">Certificate Provider</label>
            <select id="sslProvider" class="lp-input" onchange="SSLPage.toggleProviderFields()">
              <option value="letsencrypt" selected>Let's Encrypt (Trusted, requires public domain DNS)</option>
              <option value="selfsigned">Self-Signed (Instant, works on IP / localhost / internal)</option>
              <option value="custom">Custom Certificate (Paste PEM)</option>
            </select>
          </div>

          <!-- Provider Descriptions -->
          <div id="sslInfoLetsEncrypt" class="alert alert-info" style="font-size:12px;padding:8px 12px;background:rgba(13,110,253,0.1);border-color:rgba(13,110,253,0.3);color:inherit;">
            <i class="bi bi-info-circle"></i> Uses <code>acme.sh</code> with Webroot validation. The domain must point to this server's public IP on port 80.
          </div>
          <div id="sslInfoSelfSigned" class="alert alert-warning" style="font-size:12px;padding:8px 12px;background:rgba(255,193,7,0.1);border-color:rgba(255,193,7,0.3);color:inherit;display:none;">
            <i class="bi bi-lightning-charge"></i> Generates a certificate instantly using OpenSSL on this server. No public DNS or domain needed.
          </div>

          <!-- Custom Certificate Inputs -->
          <div id="sslCustomFields" style="display:none;">
            <div class="lp-form-group">
              <label class="lp-label" style="font-size:11px">Certificate (fullchain.pem)</label>
              <textarea id="sslCustomCertInput" class="lp-input font-mono" rows="3" style="font-size:11px" placeholder="-----BEGIN CERTIFICATE-----"></textarea>
            </div>
            <div class="lp-form-group">
              <label class="lp-label" style="font-size:11px">Private Key (privkey.pem)</label>
              <textarea id="sslCustomKeyInput" class="lp-input font-mono" rows="3" style="font-size:11px" placeholder="-----BEGIN PRIVATE KEY-----"></textarea>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn-lp btn-lp-ghost" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn-lp btn-lp-primary" id="btnSubmitIssue">Issue Certificate</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="/js/ssl.js"></script>
