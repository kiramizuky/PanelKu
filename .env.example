# ========================
# Linux Panel — .env config
# ========================

# App
NODE_ENV=development
PORT=23456
APP_NAME=Panelku
APP_URL=http://localhost:23456
APP_SECRET=change_this_to_a_very_long_random_secret_string

# JWT
JWT_SECRET=change_this_jwt_secret_very_long_random_string
JWT_EXPIRES_IN=30d
JWT_REFRESH_SECRET=change_this_refresh_secret_very_long_random
JWT_REFRESH_EXPIRES_IN=7d

# SQLite Database
DB_PATH=./storage/panelku.db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Session
SESSION_COOKIE_NAME=lp_session
SESSION_MAX_AGE=604800000

# 2FA
TOTP_ISSUER=Panelku

# Upload
UPLOAD_MAX_SIZE=104857600
UPLOAD_PATH=./storage/uploads

# Backup Storage
BACKUP_PATH=./storage/backups

# Logs
LOG_LEVEL=info
LOG_PATH=./storage/logs

# Rate Limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Security / bootstrap
# Initial admin password used only when the database has no users.
# The installer fills this with a random value; leave empty to use the legacy
# default (a forced password change is still applied on first login).
# ADMIN_PASSWORD=
# Prometheus /metrics: when set, requires "Authorization: Bearer <token>"
# or "?token=<token>". When empty, only loopback scrapers are allowed.
# METRICS_TOKEN=
# Share one /metrics snapshot between scrapes for this many ms (0 = disabled).
# PROMETHEUS_CACHE_MS=10000
# Timeout for each systeminformation probe used by monitoring/analytics.
# SI_TIMEOUT_MS=3000
# API docs (Swagger) are disabled in production unless explicitly enabled.
# ENABLE_API_DOCS=true

# Docker daemon connection. docker-compose sets this to the socket proxy.
# Leave empty on bare metal to use /var/run/docker.sock.
# DOCKER_HOST=tcp://docker-socket-proxy:2375

# Updater supervisor (Linux/systemd)
# Service name restarted after an update (pm2 name or systemd unit).
# PANELKU_SERVICE=panelku
# How long the detached supervisor waits for /api/health before rollback.
# PANELKU_UPDATE_HEALTH_TIMEOUT=120000
# Set to false to use the old in-process updater (containers/unsupported hosts).
# PANELKU_UPDATE_SUPERVISOR=false

# External Databases Credentials
DB_MYSQL_HOST=localhost
DB_MYSQL_USER=root
DB_MYSQL_PASSWORD=
DB_PG_HOST=localhost
DB_PG_USER=postgres
DB_PG_PASSWORD=
